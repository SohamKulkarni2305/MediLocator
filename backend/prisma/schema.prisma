// MediLocator — Prisma Schema
// Maps 1:1 to TypeScript interfaces in src/types.ts and src/context/PrescriptionContext.tsx

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  PHARMACIST
  CUSTOMER
}

enum PharmacyStatus {
  pending
  approved
  rejected
  inspection_pending
}

enum PrescriptionStatus {
  pending
  approved
  rejected
  verified
  expired
}

enum CaseStatus {
  Queued
  OCR_Processing
  Pre_Screened
  Ready_for_Match
  Active
}

enum AuditLogType {
  APPROVED
  BLOCKED
  AUDIT
  DISPATCH
}

enum PrescriptionSource {
  camera
  file
  abha_sync
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid()) @map("_id")
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(CUSTOMER)
  abhaId       String?
  phone        String?
  mrn          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  prescriptions       Prescription[]        @relation("PatientPrescriptions")
  reviewedCases       PharmacistCase[]      @relation("PharmacistReviewer")
  signedPrescriptions Prescription[]        @relation("PharmacistSignoffs")
  sessions            RefreshSession[]

  @@index([abhaId])
  @@index([mrn])
  @@map("users")
}

model RefreshSession {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_sessions")
}

// ─── Drugs ────────────────────────────────────────────────────────────────────

model Drug {
  id                 String  @id @default(cuid()) @map("_id")
  brandName          String
  genericName        String
  saltName           String
  strength           String?
  dosageForm         String?
  manufacturer       String
  isBrand            Boolean @default(false)
  priceUsd           Float
  priceInr           Float
  originalPriceUsd   Float?
  originalPriceInr   Float?
  ndcCode            String?
  equivalenceCode    String  // 'AB', 'AA', etc.
  certification      String  // 'WHO-GMP', 'FDA Approved'
  lotNumber          String?
  expiryDate         String?
  savingsPercentage  Int     @default(0)
  inStock            Boolean @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([saltName])
  @@index([genericName])
  @@map("drugs")
}

// ─── Orange Book ──────────────────────────────────────────────────────────────

model OrangeBookEntry {
  id               String @id @default(cuid()) @map("_id")
  brandName        String
  saltName         String
  dosageForm       String
  equivalenceCode  String
  ceilingPriceUsd  String
  ceilingPriceInr  String
  genericMedianUsd String
  genericMedianInr String
  savingsPercent   String
  savingsUsd       String
  savingsInr       String

  @@index([saltName])
  @@map("orange_book_entries")
}

// ─── Pharmacies ───────────────────────────────────────────────────────────────

model Pharmacy {
  id            String         @id @default(cuid()) @map("_id")
  name          String
  code          String         @unique
  licenseNumber String
  staffCount    String
  cluster       String
  location      String
  status        PharmacyStatus @default(pending)
  gstinVerified Boolean        @default(false)
  submittedAt   DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  documents  PharmacyDocument[]
  auditLogs  AuditLog[]
  orders     Order[]

  @@map("pharmacies")
}

model PharmacyDocument {
  id         String  @id @default(cuid()) @map("_id")
  pharmacyId String
  name       String
  verified   Boolean @default(false)
  statusText String?

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([pharmacyId])
  @@map("pharmacy_documents")
}

model AuditLog {
  id          String       @id @default(cuid()) @map("_id")
  pharmacyId  String
  type        AuditLogType
  title       String
  description String
  timestamp   DateTime     @default(now())
  signature   String?
  details     Json         // Array of { label, value, isHighlight?, isWarning? }

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([pharmacyId])
  @@map("audit_logs")
}

// ─── Prescriptions ────────────────────────────────────────────────────────────

model Prescription {
  id                 String             @id @default(cuid()) @map("_id")
  rxNumber           String             @unique
  patientId          String
  pharmacistId       String?
  fileName           String
  fileSize           String
  source             PrescriptionSource @default(file)
  sourceLabel        String
  uploadDate         String
  uploadTimestamp    String
  doctorName         String
  doctorSpecialty    String
  doctorReg          String
  clinicName         String
  clinicLocation     String
  status             PrescriptionStatus @default(pending)
  statusLabel        String             @default("Pending Pharmacist Review")
  statusDescription  String             @default("")
  ocrConfidence      Float              @default(0)
  validUntil         String             @default("Under Verification")
  daysRemaining      Int?
  refillsAllowed     Int                @default(1)
  refillsRemaining   Int                @default(1)
  auditHash          String
  rejectionReason    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  patient          User               @relation("PatientPrescriptions", fields: [patientId], references: [id])
  pharmacist       User?              @relation("PharmacistSignoffs", fields: [pharmacistId], references: [id])
  medicines        PrescriptionMedicine[]
  pharmacistCase   PharmacistCase?
  orders           Order[]
  pharmacistSignoff PharmacistSignoff?

  @@index([patientId])
  @@index([status])
  @@map("prescriptions")
}

model PrescriptionMedicine {
  id               String @id @default(cuid()) @map("_id")
  prescriptionId   String
  brandedName      String
  genericName      String
  dosage           String
  duration         String
  genericSavingsUsd Float @default(0)
  genericSavingsInr Float @default(0)

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("prescription_medicines")
}

model PharmacistSignoff {
  id             String   @id @default(cuid()) @map("_id")
  prescriptionId String   @unique
  name           String
  license        String
  timestamp      String

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@map("pharmacist_signoffs")
}

// ─── Pharmacist Cases ─────────────────────────────────────────────────────────

model PharmacistCase {
  id               String     @id @default(cuid()) @map("_id")
  caseNumber       String     @unique
  prescriptionId   String     @unique
  pharmacistId     String?
  patientName      String
  patientAge       Int
  patientGender    String     // 'Male' | 'Female'
  mrn              String
  bp               String
  hba1c            String
  condition        String
  allergies        String
  prescriberName   String
  prescriberDegree String
  clinicName       String
  clinicAddress    String
  clinicLicense    String
  prescriberReg    String
  slaRemainingSeconds Int     @default(900)
  status           CaseStatus @default(Queued)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  // Relations
  prescription Prescription    @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  pharmacist   User?           @relation("PharmacistReviewer", fields: [pharmacistId], references: [id])
  lineItems    CaseLineItem[]
  molecules    CaseMolecule[]

  @@index([status])
  @@map("pharmacist_cases")
}

model CaseLineItem {
  id                  String @id @default(cuid()) @map("_id")
  caseId              String
  brandedName         String
  brandedManufacturer String
  brandedPriceUsd     Float
  brandedPriceInr     Float
  genericName         String
  genericManufacturer String
  genericPriceUsd     Float
  genericPriceInr     Float
  dosageInstructions  String
  quantity            String
  equivalenceCode     String
  lotNumber           String
  expiryDate          String
  verified            Boolean @default(false)

  case PharmacistCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("case_line_items")
}

model CaseMolecule {
  id        String @id @default(cuid()) @map("_id")
  caseId    String
  name      String
  confidence Float
  drugClass String
  status    String

  case PharmacistCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("case_molecules")
}

// ─── Orders ───────────────────────────────────────────────────────────────────

model Order {
  id                   String   @id @default(cuid()) @map("_id")
  prescriptionId       String
  patientId            String
  pharmacyId           String
  orderId              String   @unique
  patientName          String
  etaMinutes           Int
  courierName          String
  courierSpeedKmh      Float
  courierDistanceMeters Int
  temperatureCelsius   Float
  currentMilestoneIndex Int     @default(0)
  dispensaryName       String
  dispensaryAddress    String
  pharmacistInCharge   String
  totalSavedUsd        Float    @default(0)
  totalPaidUsd         Float    @default(0)
  totalSavedInr        Float    @default(0)
  totalPaidInr         Float    @default(0)
  handoverOtp          String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relations
  prescription Prescription    @relation(fields: [prescriptionId], references: [id])
  pharmacy     Pharmacy        @relation(fields: [pharmacyId], references: [id])
  milestones   OrderMilestone[]

  @@index([prescriptionId])
  @@map("orders")
}

model OrderMilestone {
  id        String  @id @default(cuid()) @map("_id")
  orderId   String
  step      String
  time      String
  detail    String
  completed Boolean @default(false)
  current   Boolean @default(false)
  sortOrder Int     @default(0)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_milestones")
}
